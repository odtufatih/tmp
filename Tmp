               .append(issue2.getIssueName())
               .append("\">")
               .append(issue2.getIssueName())
               .append("</a>(")
               .append(issue2.getStatus())
               .append(")");

       htmlReport.append(
               "<br/><br/>");

       for (String cmnFile :
               issue2.getCommonFilesWithLeftIssue()) {

           htmlReport.append(
                   "<br/>")
                   .append(cmnFile);
       }

       htmlReport.append(
               "&nbsp;&nbsp;</td>");

       addRightIssuesToReport(
               issue2,
               htmlReport);

       htmlReport.append("</tr>");
   }

   htmlReport.append(
           "</table></td>");
  ```

