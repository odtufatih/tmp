   /**
    * Builds the dependency hierarchy.
    *
    * The expensive file-level SVN operations are executed in parallel.
    * The hierarchy modification itself is performed afterwards in the
    * current thread so that the tree remains deterministic.
    */
   public void findRightIssues() {

       log("Level " + level);
       log("Finding right issues for " + issueName);

       String query =
               "select revisions from dir / where comment =~ \\\""
                       + issueName
                       + "$\\\" or comment =~ \\\""
                       + issueName
                       + "[ \\t\\n\\r\\f,.]+\\\" group by changeset";

       try {

           Map<String, String> map =
                   getIssueFiles(query);

           if (map.isEmpty()) {
               return;
           }


           List<String> issueFiles =
                   new ArrayList<String>(
                           map.keySet());


           /*
            * Every file can be processed independently.
            */
           List<Future<PreviousIssueResult>> futures =
                   new ArrayList<Future<PreviousIssueResult>>(
                           issueFiles.size());


           for (String issueFile : issueFiles) {

               String revision =
                       map.get(issueFile);

               futures.add(
                       executor.submit(
                               new FileHistoryTask(
                                       issueFile,
                                       revision,
                                       issueName)));
           }


           /*
            * Merge the results sequentially.
            */
           for (Future<PreviousIssueResult> future :
                   futures) {

               try {

                   PreviousIssueResult result =
                           future.get();

                   if (result != null) {
                       processPreviousIssue(result);
                   }

               } catch (Exception e) {

                   log("Unable to process file history: "
                           + e.getMessage());
               }
           }


           /*
            * Child dependency trees are independent.
            *
            * They are executed in parallel as well, but the parent
            * hierarchy has already been completely constructed.
            */
           List<Future<?>> childFutures =
                   new ArrayList<Future<?>>(
                           rightIssues.size());

           for (final Issue rightIssue :
                   rightIssues) {

               childFutures.add(
                       executor.submit(
                               new Runnable() {

                                   @Override
                                   public void run() {
                                       rightIssue.findRightIssues();
                                   }
                               }));
           }


           for (Future<?> childFuture :
                   childFutures) {

               try {
                   childFuture.get();

               } catch (Exception e) {

                   log("Unable to construct child dependency: "
                           + e.getMessage());
               }
           }

       } catch (Exception e) {

           log(e.getMessage());

           throw new BuildException(e);
       }
   }


   /**
    * Retrieves all files/revisions for an issue from Fisheye.
    */
   private Map<String, String> getIssueFiles(
           String query) {

       Map<String, String> map =
               new HashMap<String, String>();

       Map<String, String> params =
               new HashMap<String, String>();

       params.put(
               "rep",
               fishEyeRepositoryName);

       params.put(
               "query",
               query);

       params.put(
               "auth",
               fisheyeAuthToken);


       Document changes;

       try {

           changes =
                   FisheyeUtils.callFisheye(
                           fishEyeHost,
                           "query",
                           params);

       } catch (Exception e) {

           throw new BuildException(
                   "Fisheye query failed for "
                           + issueName,
                   e);
       }


       Node root =
               changes.getRootElement();

       if (root.getName().equals("error")) {

           throw new BuildException(
                   "*** received error response: "
                           + root.getText());
       }


       List<?> changeNodes =
               changes.selectNodes(
                       "/response/revisionkey");


       for (Iterator<?> iterator =
               changeNodes.iterator();
               iterator.hasNext();) {

           Node node =
                   (Node) iterator.next();

           String path =
                   node.valueOf("@path");

           String revision =
                   node.valueOf("@rev");


           /*
            * If the same path appears more than once,
            * keep the newest revision.
            */
           if (map.containsKey(path)) {

               String oldRevision =
                       map.get(path);

               if (Integer.parseInt(revision)
                       > Integer.parseInt(oldRevision)) {

                   map.put(path, revision);
               }

           } else {

               map.put(path, revision);
           }
       }

       return map;
   }


   /**
    * Merges a file-history result into the dependency tree.
    */
   private void processPreviousIssue(
           PreviousIssueResult result) {

       String previousIssueName =
               result.previousIssueName;

       String previousIssueStatus =
               result.previousIssueStatus;

       String issueFile =
               result.issueFile;


       if (deployedStatusList.contains(
               previousIssueStatus)) {

           log(previousIssueName
                   + " is a deployed issue, it will not be checked further");

           return;
       }


       Issue rightIssue =
               getRightIssue(previousIssueName);


       if (rightIssue != null) {

           rightIssue
                   .getCommonFilesWithLeftIssue()
                   .add(issueFile);

           return;
       }


       String status =
               jiraStasusMap == null
                       ? null
                       : jiraStasusMap.get(
                               previousIssueStatus);


       rightIssue =
               new Issue(
                       previousIssueName,
                       level + 1,
                       status == null ? "" : status);


       rightIssue
               .getCommonFilesWithLeftIssue()
               .add(issueFile);


       rightIssue
               .getLeftIssues()
               .addAll(getLeftIssues());

       rightIssue
               .getLeftIssues()
               .add(this);


       /*
        * Do not add an issue that already exists on the left side
        * of the dependency hierarchy. This prevents circular trees.
        */
       if (!getLeftIssues().contains(rightIssue)) {

           rightIssues.add(rightIssue);

       } else {

           log(previousIssueName
                   + " is an already checked issue in the hierarchy.."
                   + "a deeper previous issue will be searched..");
       }
   }


   private Issue getRightIssue(
           String issueName) {

       for (Issue rightIssue :
               rightIssues) {

           if (rightIssue.issueName.equals(issueName)) {
               return rightIssue;
           }
       }

       return null;
   }


   @Override
   public boolean equals(Object issue) {

       if (this == issue) {
           return true;
       }

       if (!(issue instanceof Issue)) {
           return false;
       }

       Issue iss =
               (Issue) issue;

       return issueName != null
               && issueName.equals(
                       iss.getIssueName());
   }


   @Override
   public int hashCode() {

       return issueName == null
               ? 0
               : issueName.hashCode();
   }
  ```

  }

  /**

  * Performs SVN history lookup for one file.
  *
  * This class deliberately does not modify the Issue hierarchy.
  * It only returns data. This is what makes parallel execution safe.
    */
    private class FileHistoryTask
    implements Callable<PreviousIssueResult> {

    private final String issueFile;
    private final String revision;
    private final String currentIssueName;

    FileHistoryTask(
    String issueFile,
    String revision,
    String currentIssueName) {

    ```
     this.issueFile = issueFile;
     this.revision = revision;
     this.currentIssueName = currentIssueName;
    ```

    }

    @Override
    public PreviousIssueResult call() {

    ```
     try {

         log("Log messages for "
                 + issueFile
                 + " is being retrieved..");


         ISVNClientAdapter client =
                 workerSvnClient.get();


         ISVNLogMessage[] logMessages =
                 client.getLogMessages(
                         new SVNUrl(
                                 svnRepositoryUrl
                                         + issueFile),
                         getRevisionFrom(revision),
                         getRevisionFrom("0"));


         /*
          * The SVN log is ordered from newest to oldest.
          * Therefore the first different issue is the one we need.
          */
         for (ISVNLogMessage logMessage :
                 logMessages) {

             String message =
                     logMessage.getMessage();

             if (message == null) {
                 continue;
             }

             message =
                     message.trim();

             if (message.isEmpty()) {
                 continue;
             }

             if (currentIssueName.equals(message)) {
                 continue;
             }


             String previousIssueStatus =
                     getJiraIssueStatus(message);


             log(message
                     + " is a previous issue for "
                     + currentIssueName);


             return new PreviousIssueResult(
                     issueFile,
                     message,
                     previousIssueStatus);
         }

     } catch (Exception e) {

         log("Log messages of "
                 + issueFile
                 + " cannot be retrieved: "
                 + e.getMessage());
     }

     return null;
    ```

    }
    }

  /**

  * Result of processing one SVN file history.
    */
    private static class PreviousIssueResult {

    private final String issueFile;
    private final String previousIssueName;
    private final String previousIssueStatus;

    PreviousIssueResult(
    String issueFile,
    String previousIssueName,
    String previousIssueStatus) {

    ```
     this.issueFile = issueFile;
     this.previousIssueName = previousIssueName;
     this.previousIssueStatus = previousIssueStatus;
    ```

    }
    }

  /**

  * Gets a Jira issue status.
  *
  * Results are cached because the same issue can appear in many SVN
  * histories.
    */
    private String getJiraIssueStatus(
    String issueName) {

    String cached =
    jiraStatusCache.get(issueName);

    if (cached != null) {
    return cached;
    }

    String status =
    workerJiraClient
    .get()
    .getIssueStatus(issueName);

    if (status == null) {
    status = "";
    }

    String existing =
    jiraStatusCache.putIfAbsent(
    issueName,
    status);

    return existing != null
    ? existing
    : status;
    }

