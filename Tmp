  @Override
  public void execute() throws BuildException {

  ```
   validateAttributes();

   if (issues == null || issues.trim().isEmpty()) {
       log("There are no issues to build");
       return;
   }

   /*
    * Make sure the SVNKit factory is initialized before worker threads
    * start creating SVN clients.
    */
   try {
       SvnKitClientAdapterFactory.setup();
   } catch (SVNClientException e) {
       throw new BuildException(
               "Unable to initialize SVNKit client factory", e);
   }

   /*
    * Fisheye authentication is performed once instead of once per issue
    * or once per file.
    */
   try {
       fisheyeAuthToken =
               FisheyeUtils.getFisheyeAuthToken(fishEyeHost);
   } catch (Exception e) {
       throw new BuildException(
               "Unable to get Fisheye authentication token", e);
   }

   jiraStatusCache.clear();

   executor = Executors.newFixedThreadPool(parallelism);

   BufferedWriter writer = null;

   try {

       List<String> issueNames = new ArrayList<String>();

       StringTokenizer tokenizer =
               new StringTokenizer(issues, ",");

       while (tokenizer.hasMoreTokens()) {
           issueNames.add(tokenizer.nextToken().trim());
       }

       /*
        * Root issues are completely independent from each other.
        * Therefore they can be processed concurrently.
        */
       List<Future<Issue>> futures =
               new ArrayList<Future<Issue>>();

       for (String issueName : issueNames) {

           futures.add(
                   executor.submit(new Callable<Issue>() {

                       @Override
                       public Issue call() {

                           Issue issue =
                                   new Issue(issueName, 1);

                           log(issue.getIssueName()
                                   + " : Dependency hierarchy is being constructed..");

                           issue.findRightIssues();

                           return issue;
                       }
                   })
           );
       }

       List<Issue> rootIssues =
               new ArrayList<Issue>();

       for (Future<Issue> future : futures) {

           try {
               rootIssues.add(future.get());

           } catch (Exception e) {
               throw new BuildException(
                       "Unable to construct dependency hierarchy", e);
           }
       }


       /*
        * HTML generation is intentionally kept single-threaded.
        * StringBuilder is therefore completely safe here.
        */
       StringBuilder htmlReport =
               new StringBuilder(8192);

       htmlReport.append(
               "<html><body><table border=\"1\">");


       for (Issue issue : rootIssues) {

           htmlReport.append("<tr>");

           htmlReport.append(
                   "<td>&nbsp;&nbsp;<a href=\"")
                   .append(jiraBrowseUrl)
                   .append(issue.getIssueName())
                   .append("\">")
                   .append(issue.getIssueName())
                   .append("</a>&nbsp;&nbsp;</td>");

           addRightIssuesToReport(
                   issue,
                   htmlReport);

           htmlReport.append("</tr>");
       }


       htmlReport.append(
               "</table></body></html>");


       writer =
               new BufferedWriter(
                       new FileWriter(outputFile));

       writer.write(
               htmlReport.toString());

   } catch (BuildException e) {

       throw e;

   } catch (Exception e) {

       throw new BuildException(e);

   } finally {

       if (writer != null) {

           try {
               writer.flush();
               writer.close();

           } catch (IOException e) {
               log("Unable to close output file: "
                       + e.getMessage());
           }
       }

       shutdownExecutor();
       workerSvnClient.remove();
       workerJiraClient.remove();
   }
  ```

  }

  private void shutdownExecutor() {

  ```
   if (executor == null) {
       return;
   }

   executor.shutdown();

   try {

       if (!executor.awaitTermination(60, TimeUnit.SECONDS)) {

           log("Executor did not terminate within 60 seconds. "
                   + "Forcing shutdown.");

           executor.shutdownNow();
       }

   } catch (InterruptedException e) {

       Thread.currentThread().interrupt();

       executor.shutdownNow();
   }
  ```

  }

  private void addRightIssuesToReport(
  Issue issue,
  StringBuilder htmlReport) {

  ```
   List<Issue> rightIssues =
           issue.getRightIssues();

   htmlReport.append(
           "<td><table border=\"1\">");

   for (Issue issue2 : rightIssues) {

       htmlReport.append("<tr>");

       htmlReport.append(
               "<td>&nbsp;&nbsp;<a href=\"")
