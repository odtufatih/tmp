  public void setJiraStatuses(String jiraStasuses) {

  ```
   jiraStasusMap = new HashMap<String, String>();

   if (jiraStasuses == null || jiraStasuses.trim().isEmpty()) {
       return;
   }

   StringTokenizer tokenizer =
           new StringTokenizer(jiraStasuses, ",");

   while (tokenizer.hasMoreTokens()) {

       String token = tokenizer.nextToken();

       int index = token.indexOf("#");

       if (index > 0) {
           jiraStasusMap.put(
                   token.substring(0, index),
                   token.substring(index + 1));
       }
   }
  ```

  }

