  private class Issue {

  ```
   private String issueName;

   /**
    * Issues which are on the right side of this issue.
    */
   private List<Issue> rightIssues =
           new ArrayList<Issue>();

   /**
    * Issues which are on the left side of this issue.
    */
   private List<Issue> leftIssues =
           new ArrayList<Issue>();

   /**
    * Files shared with left issues.
    */
   private List<String> commonFilesWithLeftIssue =
           new ArrayList<String>();

   /**
    * Dependency hierarchy level.
    *
    * Root = 1
    * Right issue = parent level + 1
    */
   private int level;

   /**
    * Jira status display name.
    */
   private String status;


   public Issue(String issueName) {
       this.issueName = issueName;
   }


   public Issue(
           String issueName,
           int level) {

       this.issueName = issueName;
       this.level = level;
   }


   public Issue(
           String issueName,
           int level,
           String status) {

       this.issueName = issueName;
       this.level = level;
       this.status = status;
   }


   public String getIssueName() {
       return issueName;
   }


   public void setIssueName(
           String issueName) {

       this.issueName = issueName;
   }


   public List<Issue> getRightIssues() {
       return rightIssues;
   }


   public void setRightIssues(
           List<Issue> rightIssues) {

       this.rightIssues = rightIssues;
   }


   public List<Issue> getLeftIssues() {
       return leftIssues;
   }


   public void setLeftIssues(
           List<Issue> leftIssues) {

       this.leftIssues = leftIssues;
   }


   public List<String>
           getCommonFilesWithLeftIssue() {

       return commonFilesWithLeftIssue;
   }


   public void setCommonFilesWithLeftIssue(
           List<String> commonFilesWithLeftIssue) {

       this.commonFilesWithLeftIssue =
               commonFilesWithLeftIssue;
   }


   public int getLevel() {
       return level;
   }


   public void setLevel(int level) {
       this.level = level;
   }


   public String getStatus() {
       return status;
   }


   public void setStatus(String status) {
       this.status = status;
   }


   /**
    * Constructs dependency hierarchy for this issue.
    */
   public void findRightIssues() {

       log(
               "[LEVEL " + level + "] "
                       + "Finding right issues for "
                       + issueName
                       + " | Thread: "
                       + Thread.currentThread().getName());


       String query =
               "select revisions from dir / where comment =~ \\\""
                       + issueName
                       + "$\\\" or comment =~ \\\""
                       + issueName
                       + "[ \\t\\n\\r\\f,.]+\\\" group by changeset";


       try {

           /*
            * First retrieve the files belonging to this issue.
            */
           Map<String, String> map =
                   getIssueFiles(query);


           log(
                   "[LEVEL " + level + "] "
                           + issueName
                           + " -> "
                           + map.size()
                           + " unique files found");


           if (map.isEmpty()) {

               log(
                       "[LEVEL " + level + "] "
                               + issueName
                               + " -> no files found");

               return;
           }


           List<String> issueFiles =
                   new ArrayList<String>(
                           map.keySet());


           /*
            * Process SVN history for every file in parallel.
            */
           List<Future<PreviousIssueResult>>
                   futures =
                   new ArrayList<Future<PreviousIssueResult>>(
                           issueFiles.size());


           for (String issueFile :
                   issueFiles) {

               String revision =
                       map.get(issueFile);

               futures.add(
                       executor.submit(
                               new FileHistoryTask(
                                       issueFile,
                                       revision,
                                       issueName,
                                       level)));
           }


           /*
            * Merge file results sequentially.
            *
            * This protects the dependency tree from concurrent
            * modifications.
            */
           for (Future<PreviousIssueResult> future :
                   futures) {

               try {

                   PreviousIssueResult result =
                           future.get();

                   if (result != null) {

                       processPreviousIssue(
                               result);
                   }

               } catch (Exception e) {

                   log(
                           "[LEVEL " + level + "] "
                                   + "Unable to process file history: "
                                   + e.getMessage());
               }
           }


           /*
            * Child dependencies can now be processed in parallel.
            */
           if (!rightIssues.isEmpty()) {

               log(
                       "[LEVEL " + level + "] "
                               + issueName
                               + " -> "
                               + rightIssues.size()
                               + " right issue(s) found");


               List<Future<?>>
                       childFutures =
                       new ArrayList<Future<?>>(
                               rightIssues.size());


               for (final Issue rightIssue :
                       rightIssues) {

                   childFutures.add(
                           executor.submit(
                                   new Runnable() {

                                       @Override
                                       public void run() {

                                           log(
                                                   "[LEVEL "
                                                           + rightIssue.getLevel()
                                                           + "] "
                                                           + "Starting dependency "
                                                           + rightIssue.getIssueName()
                                                           + " <- "
                                                           + issueName
                                                           + " | Thread: "
                                                           + Thread.currentThread().getName());

                                           rightIssue.findRightIssues();

                                           log(
                                                   "[LEVEL "
                                                           + rightIssue.getLevel()
                                                           + "] "
                                                           + "Finished dependency "
                                                           + rightIssue.getIssueName()
                                                           + " | Thread: "
                                                           + Thread.currentThread().getName());
                                       }
                                   }));
               }


               for (Future<?> childFuture :
                       childFutures) {

                   try {

                       childFuture.get();

                   } catch (Exception e) {

                       log(
                               "[LEVEL " + level + "] "
                                       + "Unable to construct child dependency: "
                                       + e.getMessage());
                   }
               }
           }


           log(
                   "[LEVEL " + level + "] "
                           + "Finished "
                           + issueName
                           + " | Thread: "
                           + Thread.currentThread().getName());


       } catch (Exception e) {

           log(
                   "[LEVEL " + level + "] "
                           + "Error while processing "
                           + issueName
                           + ": "
                           + e.getMessage());

           throw new BuildException(e);
       }
   }


   /**
    * Retrieves all files/revisions for an issue from Fisheye.
    */
   private Map<String, String> getIssueFiles(
           String query) {

       Map<String, String> map =
               new HashMap<String, String>();


       Map<String, String> params =
               new HashMap<String, String>();

       params.put(
               "rep",
               fishEyeRepositoryName);

       params.put(
               "query",
               query);

       params.put(
               "auth",
               fisheyeAuthToken);


       Document changes;


       try {

           changes =
                   FisheyeUtils.callFisheye(
                           fishEyeHost,
                           "query",
                           params);

       } catch (Exception e) {

           throw new BuildException(
                   "Fisheye query failed for "
                           + issueName,
                   e);
       }


       Node root =
               changes.getRootElement();


       if (root.getName().equals("error")) {

           throw new BuildException(
                   "*** received error response: "
                           + root.getText());
       }


       List<?> changeNodes =
               changes.selectNodes(
                       "/response/revisionkey");


       for (Iterator<?> iterator =
               changeNodes.iterator();
               iterator.hasNext();) {

           Node node =
                   (Node) iterator.next();


           String path =
                   node.valueOf("@path");

           String revision =
                   node.valueOf("@rev");


           /*
            * If the same path occurs more than once,
            * retain the newest revision.
            */
           if (map.containsKey(path)) {

               String oldRevision =
                       map.get(path);


               if (Integer.parseInt(revision)
                       > Integer.parseInt(oldRevision)) {

                   map.put(
                           path,
                           revision);
               }

           } else {

               map.put(
                       path,
                       revision);
           }
       }


       return map;
   }


   /**
    * Adds the result of one SVN file history search to
    * the dependency hierarchy.
    *
    * This method runs in the parent Issue thread, not in
    * the file worker thread.
    */
   private void processPreviousIssue(
           PreviousIssueResult result) {

       String previousIssueName =
               result.previousIssueName;

       String previousIssueStatus =
               result.previousIssueStatus;

       String issueFile =
               result.issueFile;


       /*
        * A deployed issue is a terminal node.
        */
       if (deployedStatusList.contains(
               previousIssueStatus)) {

           log(
                   "[LEVEL " + level + "] "
                           + previousIssueName
                           + " is a deployed issue "
                           + "(status="
                           + previousIssueStatus
                           + ") and will not be checked further"
                           + " | Found from file: "
                           + issueFile);

           return;
       }


       /*
        * The same right issue may already have been found
        * from another common file.
        */
       Issue rightIssue =
               getRightIssue(
                       previousIssueName);


       if (rightIssue != null) {

           rightIssue
                   .getCommonFilesWithLeftIssue()
                   .add(issueFile);


           log(
                   "[LEVEL " + (level + 1) + "] "
                           + previousIssueName
                           + " already exists as right issue of "
                           + issueName
                           + " | Additional common file: "
                           + issueFile);

           return;
       }


       String status =
               jiraStasusMap == null
                       ? null
                       : jiraStasusMap.get(
                               previousIssueStatus);


       /*
        * The previous issue becomes a right issue,
        * therefore its level is parent + 1.
        */
       rightIssue =
               new Issue(
                       previousIssueName,
                       level + 1,
                       status == null
                               ? ""
                               : status);


       rightIssue
               .getCommonFilesWithLeftIssue()
               .add(issueFile);


       rightIssue
               .getLeftIssues()
               .addAll(
                       getLeftIssues());


       rightIssue
               .getLeftIssues()
               .add(this);


       /*
        * Prevent circular dependency.
        */
       if (!getLeftIssues().contains(
               rightIssue)) {

           rightIssues.add(
                   rightIssue);


           log(
                   "[LEVEL "
                           + rightIssue.getLevel()
                           + "] "
                           + previousIssueName
                           + " -> RIGHT of "
                           + issueName
                           + " | File: "
                           + issueFile
                           + " | Status: "
                           + previousIssueStatus);

       } else {

           log(
                   "[LEVEL "
                           + (level + 1)
                           + "] "
                           + previousIssueName
                           + " is already on the left side of "
                           + issueName
                           + " -> circular dependency avoided"
                           + " | File: "
                           + issueFile);
       }
   }


   private Issue getRightIssue(
           String issueName) {

       for (Issue rightIssue :
               rightIssues) {

           if (rightIssue.issueName.equals(
                   issueName)) {

               return rightIssue;
           }
       }

       return null;
   }


   @Override
   public boolean equals(
           Object issue) {

       if (this == issue) {
           return true;
       }

       if (!(issue instanceof Issue)) {
           return false;
       }

       Issue iss =
               (Issue) issue;

       return issueName != null
               && issueName.equals(
                       iss.getIssueName());
   }


   @Override
   public int hashCode() {

       return issueName == null
               ? 0
               : issueName.hashCode();
   }
  ```

  }

  /**

  * Performs SVN history lookup for one file.
  *
  * No dependency hierarchy is modified here.
  * The task only returns a result.
  *
  * This makes the expensive I/O operation safe to execute
  * concurrently.
    */
    private class FileHistoryTask
    implements Callable<PreviousIssueResult> {

    private final String issueFile;
    private final String revision;
    private final String currentIssueName;
    private final int currentLevel;

    FileHistoryTask(
    String issueFile,
    String revision,
    String currentIssueName,
    int currentLevel) {

    ```
     this.issueFile =
             issueFile;

     this.revision =
             revision;

     this.currentIssueName =
             currentIssueName;

     this.currentLevel =
             currentLevel;
    ```

    }

    @Override
    public PreviousIssueResult call() {

    ```
     try {

         log(
                 "[LEVEL " + currentLevel + "] "
                         + "Retrieving SVN history for "
                         + currentIssueName
                         + " | File: "
                         + issueFile
                         + " | Revision: "
                         + revision
                         + " | Thread: "
                         + Thread.currentThread().getName());


         ISVNClientAdapter client =
                 workerSvnClient.get();


         ISVNLogMessage[] logMessages =
                 client.getLogMessages(
                         new SVNUrl(
                                 svnRepositoryUrl
                                         + issueFile),
                         getRevisionFrom(
                                 revision),
                         getRevisionFrom(
                                 "0"));


         /*
          * SVN log is normally newest -> oldest.
          *
          * Therefore the first different issue is
          * the previous issue we are looking for.
          */
         for (ISVNLogMessage logMessage :
                 logMessages) {

             String message =
                     logMessage.getMessage();


             if (message == null) {
                 continue;
             }


             message =
                     message.trim();


             if (message.isEmpty()) {
                 continue;
             }


             if (currentIssueName.equals(
                     message)) {

                 continue;
             }


             String previousIssueStatus =
                     getJiraIssueStatus(
                             message);


             log(
                     "[LEVEL " + currentLevel + "] "
                             + "Previous issue found: "
                             + message
                             + " -> "
                             + currentIssueName
                             + " | File: "
                             + issueFile
                             + " | Thread: "
                             + Thread.currentThread().getName());


             return new PreviousIssueResult(
                     issueFile,
                     message,
                     previousIssueStatus);
         }


     } catch (Exception e) {

         log(
                 "[LEVEL " + currentLevel + "] "
                         + "SVN history could not be retrieved"
                         + " | Issue: "
                         + currentIssueName
                         + " | File: "
                         + issueFile
                         + " | "
                         + e.getMessage());
     }


     return null;
    ```

    }
    }

  /**

  * Result returned from one SVN file-history worker.
    */
    private static class PreviousIssueResult {

    private final String issueFile;
    private final String previousIssueName;
    private final String previousIssueStatus;

    PreviousIssueResult(
    String issueFile,
    String previousIssueName,
    String previousIssueStatus) {

    ```
     this.issueFile =
             issueFile;

     this.previousIssueName =
             previousIssueName;

     this.previousIssueStatus =
             previousIssueStatus;
    ```

    }
    }

  /**

  * Gets Jira issue status.
  *
  * The result is cached so the same issue is not queried
  * repeatedly.
    */
    private String getJiraIssueStatus(
    String issueName) {

    String cached =
    jiraStatusCache.get(
    issueName);

    if (cached != null) {

    ```
     log(
             "Jira status cache hit: "
                     + issueName);

     return cached;
    ```

    }

    log(
    "Retrieving Jira status for "
    + issueName
    + " | Thread: "
    + Thread.currentThread().getName());

    String status =
    workerJiraClient
    .get()
    .getIssueStatus(
    issueName);

    if (status == null) {
    status = "";
    }

    String existing =
    jiraStatusCache.putIfAbsent(
    issueName,
    status);

    return existing != null
    ? existing
    : status;
    }

