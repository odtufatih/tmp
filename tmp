  private String jiraBrowseUrl;

  private String jiraStatuses;
  private Map<String, String> jiraStasusMap;

  /**

  * Number of parallel worker threads.
  *
  * 8 is a reasonable starting point.
    */
    private int parallelism = 8;

  /**

  * SVN credentials.
  *
  * Each worker creates its own SVN client.
    */
    private String svnUsername;
    private String svnPassword;

  /**

  * Fisheye authentication token.
  *
  * It is obtained once for the complete report.
    */
    private String fisheyeAuthToken;

  /**

  * Cache for Jira issue statuses.
  *
  * The same previous issue may occur in many SVN histories.
    */
    private final ConcurrentMap<String, String> jiraStatusCache =
    new ConcurrentHashMap<String, String>();

  /**

  * Shared executor used by the report.
    */
    private ExecutorService executor;

  /**

  * Each worker thread owns its own SVN client.
  *
  * SVN client instances are NOT shared between threads.
    */
    private final ThreadLocal<ISVNClientAdapter> workerSvnClient =
    new ThreadLocal<ISVNClientAdapter>() {

    ```
         @Override
         protected ISVNClientAdapter initialValue() {

             try {

                 ISVNClientAdapter client =
                         SVNClientAdapterFactory.createSVNClient(
                                 SvnKitClientAdapterFactory.SVNKIT_CLIENT);

                 if (svnUsername != null) {
                     client.setUsername(svnUsername);
                 }

                 if (svnPassword != null) {
                     client.setPassword(svnPassword);
                 }

                 return client;

             } catch (SVNClientException e) {

                 throw new IllegalStateException(
                         "Unable to create SVN client for worker thread",
                         e);
             }
         }
     };
    ```

  /**

  * Each worker thread owns its own Jira client.
    */
    private final ThreadLocal<JiraRestClient> workerJiraClient =
    new ThreadLocal<JiraRestClient>() {

    ```
         @Override
         protected JiraRestClient initialValue() {
             return new JiraRestClient(
                     jirausername,
                     jirapassword);
         }
     };
    ```

  public void setJiraStatuses(String jiraStasuses) {

  ```
   jiraStasusMap =
           new HashMap<String, String>();

   if (jiraStasuses == null
           || jiraStasuses.trim().isEmpty()) {
       return;
   }

   StringTokenizer tokenizer =
           new StringTokenizer(
                   jiraStasuses,
                   ",");

   while (tokenizer.hasMoreTokens()) {

       String token =
               tokenizer.nextToken();

       int index =
               token.indexOf("#");

       if (index > 0) {

           jiraStasusMap.put(
                   token.substring(0, index),
                   token.substring(index + 1));
       }
   }
  ```

  }

