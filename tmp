/**

* Creates SVN commit dependency report by querying Fisheye, SVN and Jira.
*
* Expensive SVN history and Jira status operations are executed in parallel.
*
* Dependency hierarchy levels are preserved and explicitly logged.
  */
  public class CreateCommitDependencyReport extends SvnCommand {

