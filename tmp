	    html.append("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">");
	    html.append("<title>SVN Commit Dependency Report</title>");

	    html.append("<style>");

	    html.append("* { box-sizing: border-box; }");

	    html.append("body {");
	    html.append("    margin: 0;");
	    html.append("    padding: 0;");
	    html.append("    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif;");
	    html.append("    background: #f4f6f9;");
	    html.append("    color: #263238;");
	    html.append("}");

	    /* =========================
