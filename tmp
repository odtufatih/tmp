        html.append(rootIssue.getIssueName());
        html.append("\" target=\"_blank\">");

        html.append(rootIssue.getIssueName());

        html.append("</a>");

        html.append("</div>");

        html.append("</div>");

        /*
         * Dependency tree
         */
        html.append("<div class=\"tree\">");

        List<Issue> children = rootIssue.getRightIssues();

        if (children == null || children.isEmpty()) {

            html.append("<div class=\"no-dependencies\">");
            html.append("No commit dependencies found.");
            html.append("</div>");

        } else {

            for (Issue child : children) {
                appendIssueTree(child, html);
            }
        }

        html.append("</div>");

        html.append("</div>");
    }

    html.append("</div>");

    /* =========================
       FOOTER
       ========================= */

    html.append("<div class=\"footer\">");
    html.append("SVN Commit Dependency Report");
    html.append("</div>");

    html.append("</body>");
    html.append("</html>");

    return html.toString();
}


/**
 * Adds an Issue and all of its right/dependency issues
 * to the HTML tree.
 */
private void appendIssueTree(Issue issue, StringBuilder html) {

    List<Issue> children = issue.getRightIssues();

    html.append("<div class=\"tree-node\">");

    /* =========================
       ISSUE ROW
       ========================= */

    html.append("<div class=\"issue-row\">");

    if (children != null && !children.isEmpty()) {

        html.append("<button class=\"toggle\" onclick=\"toggleNode(this)\">");
        html.append("&#8722;");
        html.append("</button>");

    } else {

        html.append("<button class=\"toggle empty\">");
        html.append("+");
        html.append("</button>");
    }

    /* LEVEL */

    html.append("<span class=\"level\">");
    html.append("LEVEL ");
    html.append(issue.getLevel());
    html.append("</span>");

    /* ISSUE */

    html.append("<a class=\"issue-link\" href=\"");
    html.append(jiraBrowseUrl);
    html.append(issue.getIssueName());
    html.append("\" target=\"_blank\">");

    html.append(issue.getIssueName());

    html.append("</a>");

    /* STATUS */

    if (issue.getStatus() != null
            && !issue.getStatus().trim().isEmpty()) {

        html.append("<span class=\"status\">");
        html.append(escapeHtml(issue.getStatus()));
        html.append("</span>");
    }

    html.append("</div>");

    /* =========================
       COMMON FILES
       ========================= */

    List<String> files = issue.getCommonFilesWithLeftIssue();

    if (files != null && !files.isEmpty()) {

        html.append("<div class=\"files\">");

        html.append("<div class=\"files-title\">");
        html.append("Common Files (");
        html.append(files.size());
        html.append(")");
        html.append("</div>");

        for (String file : files) {

            html.append("<div class=\"file\">");
            html.append(escapeHtml(file));
            html.append("</div>");
        }

        html.append("</div>");
    }

    /* =========================
       CHILDREN
       ========================= */

    if (children != null && !children.isEmpty()) {

        html.append("<div class=\"children\">");

        for (Issue child : children) {
            appendIssueTree(child, html);
        }

        html.append("</div>");
    }

    html.append("</div>");
}


/**
 * Counts all issues recursively.
 */
private int countIssues(List<Issue> issues) {

    if (issues == null || issues.isEmpty()) {
        return 0;
    }

    int count = 0;

    for (Issue issue : issues) {

        count++;

        if (issue.getRightIssues() != null
                && !issue.getRightIssues().isEmpty()) {

            count += countIssues(issue.getRightIssues());
        }
    }

    return count;
}


/**
 * Escapes special HTML characters.
 */
private String escapeHtml(String value) {

    if (value == null) {
        return "";
    }

    return value
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace("\"", "&quot;")
            .replace("'", "&#39;");
}
